// Documentation host (apps/site/dist-docs) on Cloudflare Workers static assets.
// Build first: node apps/site/build.ts   (writes dist/ and dist-docs/)
{
  "name": "splice-docs",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "routes": [{ "pattern": "docs.spliceloom.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist-docs",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
